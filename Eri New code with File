export default function HomeScreen() {//from the home screen functions
  const [screen, setScreen] = useState<'home' | 'add-device' | 'add-files'>('home');
  const [selectedDevice, setSelectedDevice] = useState<string | null>(null);

  const toggleDevice = (device: string) => {
    setSelectedDevice(selectedDevice === device ? null : device);
  };
//add device section but chance the select part, this comment finaly works finally
  if (screen === 'add-device') {
    return (
      <View style={styles.container}>
        <Text style={styles.title}>Select a Device Or Add a Device</Text>  
        <FlatList
          data={devices}
          keyExtractor={(item) => item}
          renderItem={({ item }) => (
            <TouchableOpacity style={styles.deviceRow} onPress={() => toggleDevice(item)}>
              <Text style={styles.deviceText}>{item}</Text>
              <View style={[styles.circle, selectedDevice === item && styles.circleSelected]} />
            </TouchableOpacity>
          )}
        />
        <TouchableOpacity style={styles.backButton} onPress={() => setScreen('home')}>
          <Text style={styles.buttonText}>Back</Text>
